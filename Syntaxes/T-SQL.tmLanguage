<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>uuid</key>
    <string>6052353D-4EDA-4263-9535-4293100AA58A</string>
    <key>name</key>
    <string>T-SQL</string>
    <key>scopeName</key>
    <string>source.tsql</string>
    <key>fileTypes</key>
    <array>
        <string>sql</string>
    </array>
    <key>patterns</key>
    <array>
        <dict><key>include</key><string>#comments</string></dict>
        <dict>
            <key>name</key>
            <string>support.constant.dbo.sql</string>
            <key>match</key>
            <string>(dbo|\[dbo\])</string>
        </dict>
        <dict><key>include</key><string>#variables</string></dict>
        <dict><key>include</key><string>#quoted-identifier</string></dict>
        <dict><key>include</key><string>#types</string></dict>
        <dict><key>include</key><string>#single-quote-string</string></dict>

        <!-- OBJECT_ID Function -->
        <dict>
            <key>begin</key>
            <string>(OBJECT_ID)(\()</string>
            <key>beginCaptures</key>
            <dict>
                <key>1</key><dict><key>name</key><string>support.function.sql</string></dict>
                <key>2</key><dict><key>name</key><string>punctuation.args.start.sql</string></dict>
            </dict>
            <key>end</key>
            <string>(\))</string>
            <key>endCaptures</key>
            <dict>
                <key>1</key><dict><key>name</key><string>punctuation.args.end.sql</string></dict>
            </dict>
            <key>name</key>
            <string>meta.f.object-id.sql</string>
            <key>patterns</key>
            <array>
                <dict><key>include</key><string>#single-quote-string</string></dict>
            </array>
        </dict>

        <!-- Keywords -->
        <dict>
            <key>name</key>
            <string>keyword.control.batch.sql</string>
            <key>match</key>
            <string>(?i)^\s*GO</string>
        </dict>
        <dict>
            <key>name</key>
            <string>keyword.control.sql</string>
            <key>match</key>
            <string>(?i)\b(EXEC)\b</string>
        </dict>
        <dict>
            <key>name</key>
            <string>keyword.control.logic.sql</string>
            <key>match</key>
            <string>(?i)\b(IF)\b</string>
        </dict>
        <dict>
            <key>name</key>
            <string>constant.language.sql</string>
            <key>match</key>
            <string>(?i)\b(NULL|NOT NULL)\b</string>
        </dict>
        <dict>
            <key>name</key>
            <string>keyword.control.operator.sql</string>
            <key>match</key>
            <string>(?i)\b(AND|OR|NOT|IS|IN|EXISTS)\b</string>
        </dict>
        <dict>
            <key>name</key>
            <string>keyword.control.definitions.sql</string>
            <key>match</key>
            <string>(?i)\b(AS|BEGIN|END)\b</string>
        </dict>
        <dict>
            <key>name</key>
            <string>keyword.data.sql</string>
            <key>match</key>
            <string>(?i)\b(INSERT|INTO|DELETE|SELECT|FROM|WHERE|UNION|VALUES|REFERENCES|PRIMARY KEY|IDENTITY|DEFAULT)\b</string>
        </dict>

        <!-- CREATE PROCEDURE -->
        <dict>
            <key>name</key>
            <string>meta.create-procedure.sql</string>
            <key>match</key>
            <string>(?i)(CREATE)\s+(PROCEDURE)\s+((?:(dbo)(\.))?\S+)</string>
            <key>captures</key>
            <dict>
                <key>1</key><dict><key>name</key><string>support.function.sql</string></dict>
                <key>2</key><dict><key>name</key><string>support.type.sql</string></dict>
                <key>3</key><dict><key>name</key><string>entity.name.function.sql</string></dict>
                <key>4</key><dict><key>name</key><string>support.constant.dbo.sql</string></dict>
                <key>5</key><dict><key>name</key><string>punctuation.delimiter.sql</string></dict>
            </dict>
        </dict>

        <!-- CREATE TABLE -->
        <dict>
            <key>name</key>
            <string>meta.create-table.sql</string>
            <key>match</key>
            <string>(?i)(CREATE)\s+(TABLE)\s+((?:(dbo)(\.))?\S+)</string>
            <key>captures</key>
            <dict>
                <key>1</key><dict><key>name</key><string>support.function.sql</string></dict>
                <key>2</key><dict><key>name</key><string>support.type.sql</string></dict>
                <key>3</key><dict><key>name</key><string>entity.name.function.sql</string></dict>
                <key>4</key><dict><key>name</key><string>support.constant.dbo.sql</string></dict>
                <key>5</key><dict><key>name</key><string>punctuation.delimiter.sql</string></dict>
            </dict>
        </dict>

        <!-- Numbers -->
        <dict>
            <key>name</key>
            <string>constant.numeric.sql</string>
            <key>match</key>
            <string>\d+</string>
        </dict>
    </array>

    <!-- Repository Section -->
    <key>repository</key>
    <dict>
        <!-- Table Variable -->
        <key>table-var</key>
        <dict>
            <key>name</key>
            <string>variable.table.sql</string>
            <key>match</key>
            <string>#[a-zA-Z_]\w*</string>
        </dict>

        <!-- Local Variable -->
        <key>local-var</key>
        <dict>
            <key>name</key>
            <string>variable.local.sql</string>
            <key>match</key>
            <string>@[a-zA-Z_]\w*</string>
        </dict>

        <!-- Script Variable -->
        <key>script-var</key>
        <dict>
            <key>name</key>
            <string>variable.scripting.sql</string>
            <key>match</key>
            <string>\$\([a-zA-Z_]\w*\)</string>
        </dict>

        <!-- Combined Variable Patterns -->
        <key>variables</key>
        <dict>
            <key>patterns</key>
            <array>
                <dict><key>include</key><string>#local-var</string></dict>
                <dict><key>include</key><string>#table-var</string></dict>
                <dict><key>include</key><string>#script-var</string></dict>
            </array>
        </dict>

        <!-- Comments -->
        <key>comments</key>
        <dict>
            <key>patterns</key>
            <array>
                <dict>
                    <key>name</key>
                    <string>comment.line.double-dash.sql</string>
                    <key>match</key>
                    <string>(--).*$</string>
                    <key>captures</key>
                    <dict>
                        <key>1</key><dict><key>name</key><string>punctuation.definition.comment.sql</string></dict>
                    </dict>
                </dict>
                <dict>
                    <key>name</key>
                    <string>comment.block.sql</string>
                    <key>begin</key>
                    <string>/\*</string>
                    <key>end</key>
                    <string>\*/</string>
                </dict>
            </array>
        </dict>

        <!-- Quoted Identifier -->
        <key>quoted-identifier</key>
        <dict>
            <key>begin</key>
            <string>\[</string>
            <key>end</key>
            <string>\]</string>
            <key>name</key>
            <string>variable.other.quoted-identifier.sql</string>
            <key>patterns</key>
            <array>
                <dict><key>include</key><string>#script-var</string></dict>
            </array>
        </dict>

        <!-- Single Quote Strings -->
        <key>single-quote-string</key>
        <dict>
            <key>begin</key>
            <string>(N?)'</string>
            <key>end</key>
            <string>'</string>
            <key>name</key>
            <string>string.quoted.single.sql</string>
            <key>patterns</key>
            <array>
                <dict><key>include</key><string>#script-var</string></dict>
            </array>
        </dict>

        <!-- Data Types -->
        <key>types</key>
        <dict>
            <key>name</key>
            <string>meta.datatype.sql</string>
            <key>match</key>
            <string><![CDATA[
(?xi)
\b(
    bigint|
    int|
    integer|
    smallint|
    tinyint|
    bit|
    (?:decimal(\()(\d+|\d+\s*,\s*\d+))|
    numeric|
    money|
    smallmoney|
    float|
    real|
    datetime|
    smalldatetime|
    char|
    varchar|
    text|
    nchar|
    (?:nvarchar(\()(\d+|(max)))|
    ntext|
    binary|
    varbinary|
    image|
    cursor|
    rowversion|
    sql_variant|
    timestamp|
    uniqueidentifier|
    xml
)\b
]]></string>
            <key>captures</key>
            <dict>
                <key>1</key><dict><key>name</key><string>storage.type.sql</string></dict>
                <key>2</key><dict><key>name</key><string>keyword.punctuation.size.start.sql</string></dict>
                <key>3</key><dict><key>name</key><string>storage.modifier.sql</string></dict>
                <key>4</key><dict><key>name</key><string>constant.language.sql</string></dict>
                <key>5</key><dict><key>name</key><string>keyword.punctuation.size.end.sql</string></dict>
            </dict>
        </dict>
    </dict>
</dict>
</plist>
